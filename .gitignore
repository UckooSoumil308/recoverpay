# ==========================================
# RecoverPay .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit real keys)
.env
.env.*
!.env.example
!frontend/.env.example
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite & Databases
*.db
*.sqlite3
recoverpay.db

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.pydevproject
.settings/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
